rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Pillar 1 / Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'neerab.sarkar00@gmail.com';
    }

    function isActiveUser(uid) {
      return exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.status == 'ACTIVE';
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.role in ['ADMIN', 'STUDENT'] &&
        data.status in ['ACTIVE', 'SUSPENDED'] &&
        data.tradingCapital is number && data.tradingCapital >= 0 &&
        data.dailyGoal is number && data.dailyGoal >= 0 &&
        data.dailyMaxLoss is number && data.dailyMaxLoss >= 0 &&
        data.maxTradesPerDay is int && data.maxTradesPerDay >= 1 && data.maxTradesPerDay <= 100 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
        (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 1000)) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidStudentInvite(data) {
      return data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
        data.status in ['INVITED', 'ACTIVE', 'SUSPENDED'] &&
        data.tradingCapital is number && data.tradingCapital >= 0 &&
        data.dailyGoal is number && data.dailyGoal >= 0 &&
        data.dailyMaxLoss is number && data.dailyMaxLoss >= 0 &&
        data.maxTradesPerDay is int && data.maxTradesPerDay >= 1 && data.maxTradesPerDay <= 100 &&
        data.createdByUid is string && data.createdByUid.size() >= 1 && data.createdByUid.size() <= 128 &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidTrade(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.tradeCode is string && data.tradeCode.size() >= 1 && data.tradeCode.size() <= 40 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.tradeDate is string && data.tradeDate.size() >= 8 && data.tradeDate.size() <= 20 &&
        data.tradeTimestampMillis is int && data.tradeTimestampMillis > 0 &&
        data.instrument is string && data.instrument.size() >= 1 && data.instrument.size() <= 40 &&
        data.direction in ['BUY', 'SELL'] &&
        data.timeframe in ['M1', 'M5', 'M15', 'M30', 'H1', 'H4', 'D1'] &&
        data.entryPrice is number && data.entryPrice >= 0 &&
        data.exitPrice is number && data.exitPrice >= 0 &&
        data.stopLoss is number && data.stopLoss >= 0 &&
        data.takeProfit is number && data.takeProfit >= 0 &&
        data.lotSize is number && data.lotSize > 0 &&
        data.riskAmount is number && data.riskAmount >= 0 &&
        data.profitLoss is number &&
        data.result in ['WIN', 'LOSS', 'BREAK_EVEN'] &&
        data.riskRewardRatio is number && data.riskRewardRatio >= 0 &&
        data.stopLossUsed is bool &&
        data.strategy is string && data.strategy.size() <= 100 &&
        data.entryReason is string && data.entryReason.size() <= 1000 &&
        data.exitReason is string && data.exitReason.size() <= 1000 &&
        data.mistakes is string && data.mistakes.size() <= 1000 &&
        data.lessonsLearned is string && data.lessonsLearned.size() <= 1000 &&
        data.notes is string && data.notes.size() <= 1500 &&
        (!('chartScreenshotBase64' in data) || (data.chartScreenshotBase64 is string && data.chartScreenshotBase64.size() <= 400000)) &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidDisciplineEntry(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.entryType in ['DAILY_PSYCHOLOGY', 'WEEKLY_REVIEW', 'MONTHLY_REVIEW'] &&
        data.periodLabel is string && data.periodLabel.size() >= 1 && data.periodLabel.size() <= 40 &&
        data.moodTag is string && data.moodTag.size() >= 1 && data.moodTag.size() <= 40 &&
        data.followedRules is bool &&
        data.respectedStopLoss is bool &&
        data.overtraded is bool &&
        data.psychologyNotes is string && data.psychologyNotes.size() <= 1500 &&
        data.mistakesSummary is string && data.mistakesSummary.size() <= 1500 &&
        data.improvementsPlan is string && data.improvementsPlan.size() <= 1500 &&
        data.disciplineScore is int && data.disciplineScore >= 1 && data.disciplineScore <= 10 &&
        data.createdAt is timestamp && data.createdAt <= request.time &&
        data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().userId == userId &&
        incoming().keys().hasAll(['userId', 'name', 'email', 'role', 'status', 'tradingCapital', 'dailyGoal', 'dailyMaxLoss', 'maxTradesPerDay', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'name', 'email', 'role', 'status', 'tradingCapital', 'dailyGoal', 'dailyMaxLoss', 'maxTradesPerDay', 'photoUrl', 'adminNotes', 'createdAt', 'updatedAt']) &&
        (
          isAdmin() ||
          (
            request.auth.uid == userId &&
            incoming().role == 'STUDENT' &&
            incoming().status == 'ACTIVE' &&
            (!('adminNotes' in incoming()) || incoming().adminNotes == '')
          )
        );

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUserProfile(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        (
          (
            isAdmin() &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'email', 'role', 'status', 'tradingCapital', 'dailyGoal', 'dailyMaxLoss', 'maxTradesPerDay', 'photoUrl', 'adminNotes', 'updatedAt'])
          ) ||
          (
            request.auth.uid == userId &&
            existing().status == 'ACTIVE' &&
            incoming().role == existing().role &&
            incoming().status == existing().status &&
            incoming().email == existing().email &&
            incoming().diff(existing()).affectedKeys().hasOnly(['name', 'photoUrl', 'tradingCapital', 'dailyGoal', 'dailyMaxLoss', 'maxTradesPerDay', 'updatedAt'])
          )
        );

      allow delete: if isAdmin() && isValidId(userId);
    }

    match /student_invites/{inviteId} {
      allow get: if isSignedIn() && isValidId(inviteId) && (
        isAdmin() ||
        (request.auth.token.email_verified == true && existing().email == request.auth.token.email)
      );
      allow list: if isSignedIn() && (
        isAdmin() ||
        (request.auth.token.email_verified == true && resource.data.email == request.auth.token.email)
      );

      allow create: if isAdmin() &&
        isValidId(inviteId) &&
        isValidStudentInvite(incoming()) &&
        incoming().createdByUid == request.auth.uid &&
        incoming().keys().hasAll(['email', 'name', 'status', 'tradingCapital', 'dailyGoal', 'dailyMaxLoss', 'maxTradesPerDay', 'createdByUid', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['email', 'name', 'status', 'tradingCapital', 'dailyGoal', 'dailyMaxLoss', 'maxTradesPerDay', 'notes', 'createdByUid', 'createdAt', 'updatedAt']);

      allow update: if isAdmin() &&
        isValidId(inviteId) &&
        isValidStudentInvite(incoming()) &&
        incoming().createdByUid == existing().createdByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['email', 'name', 'status', 'tradingCapital', 'dailyGoal', 'dailyMaxLoss', 'maxTradesPerDay', 'notes', 'updatedAt']);

      allow delete: if isAdmin() && isValidId(inviteId);
    }

    match /trades/{tradeId} {
      allow get: if isSignedIn() && isValidId(tradeId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(tradeId) &&
        isValidTrade(incoming()) &&
        incoming().keys().hasAll(['userId', 'tradeCode', 'userName', 'tradeDate', 'tradeTimestampMillis', 'instrument', 'direction', 'timeframe', 'entryPrice', 'exitPrice', 'stopLoss', 'takeProfit', 'lotSize', 'riskAmount', 'profitLoss', 'result', 'riskRewardRatio', 'stopLossUsed', 'strategy', 'entryReason', 'exitReason', 'mistakes', 'lessonsLearned', 'notes', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'tradeCode', 'userName', 'tradeDate', 'tradeTimestampMillis', 'instrument', 'direction', 'timeframe', 'entryPrice', 'exitPrice', 'stopLoss', 'takeProfit', 'lotSize', 'riskAmount', 'profitLoss', 'result', 'riskRewardRatio', 'stopLossUsed', 'strategy', 'entryReason', 'exitReason', 'mistakes', 'lessonsLearned', 'notes', 'chartScreenshotBase64', 'createdAt', 'updatedAt']) &&
        (
          isAdmin() ||
          (incoming().userId == request.auth.uid && isActiveUser(request.auth.uid))
        );

      allow update: if isSignedIn() &&
        isValidId(tradeId) &&
        isValidTrade(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().tradeCode == existing().tradeCode &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['userName', 'tradeDate', 'tradeTimestampMillis', 'instrument', 'direction', 'timeframe', 'entryPrice', 'exitPrice', 'stopLoss', 'takeProfit', 'lotSize', 'riskAmount', 'profitLoss', 'result', 'riskRewardRatio', 'stopLossUsed', 'strategy', 'entryReason', 'exitReason', 'mistakes', 'lessonsLearned', 'notes', 'chartScreenshotBase64', 'updatedAt']) &&
        (
          isAdmin() ||
          (existing().userId == request.auth.uid && isActiveUser(request.auth.uid))
        );

      allow delete: if isSignedIn() && isValidId(tradeId) && (
        isAdmin() ||
        (existing().userId == request.auth.uid && isActiveUser(request.auth.uid))
      );
    }

    match /discipline_entries/{entryId} {
      allow get: if isSignedIn() && isValidId(entryId) && (existing().userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn() &&
        isValidId(entryId) &&
        isValidDisciplineEntry(incoming()) &&
        incoming().keys().hasAll(['userId', 'userName', 'entryType', 'periodLabel', 'moodTag', 'followedRules', 'respectedStopLoss', 'overtraded', 'psychologyNotes', 'mistakesSummary', 'improvementsPlan', 'disciplineScore', 'createdAt', 'updatedAt']) &&
        incoming().keys().hasOnly(['userId', 'userName', 'entryType', 'periodLabel', 'moodTag', 'followedRules', 'respectedStopLoss', 'overtraded', 'psychologyNotes', 'mistakesSummary', 'improvementsPlan', 'disciplineScore', 'createdAt', 'updatedAt']) &&
        (
          isAdmin() ||
          (incoming().userId == request.auth.uid && isActiveUser(request.auth.uid))
        );

      allow update: if isSignedIn() &&
        isValidId(entryId) &&
        isValidDisciplineEntry(incoming()) &&
        incoming().userId == existing().userId &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['userName', 'entryType', 'periodLabel', 'moodTag', 'followedRules', 'respectedStopLoss', 'overtraded', 'psychologyNotes', 'mistakesSummary', 'improvementsPlan', 'disciplineScore', 'updatedAt']) &&
        (
          isAdmin() ||
          (existing().userId == request.auth.uid && isActiveUser(request.auth.uid))
        );

      allow delete: if isSignedIn() && isValidId(entryId) && (
        isAdmin() ||
        (existing().userId == request.auth.uid && isActiveUser(request.auth.uid))
      );
    }
  }
}
